# user-service — local (non-docker) development. In docker-compose these come from the root .env.
SERVICE_NAME=user-service
ENV=development
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5433/userdb
RABBITMQ_URL=amqp://cogo:CHANGE_ME@localhost:5672/
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=cogo-auth
JWT_AUDIENCE=cogo-api
REDIS_URL=redis://localhost:6380/3
SERVICE_PRIVATE_KEY_FILE=../../secrets/service-keys/user-service.pem
SERVICE_PUBLIC_KEYS_DIR=../../secrets/service-keys/public
JOURNEY_SERVICE_URL=http://localhost:8003
SOCIAL_SERVICE_URL=http://localhost:8004
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/cogo-media
MEDIA_ACCESS_KEY=CHANGE_ME
MEDIA_SECRET_KEY=CHANGE_ME
MEDIA_DEV_BOOTSTRAP=true
