# user-service — local (non-docker) development. In docker-compose these come from the root .env.
SERVICE_NAME=user-service
ENV=development
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5433/userdb
RABBITMQ_URL=amqp://cogo:CHANGE_ME@localhost:5672/
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=cogo-auth
JWT_AUDIENCE=cogo-api
